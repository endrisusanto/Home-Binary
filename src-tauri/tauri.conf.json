{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Build HomeBinary",
  "version": "0.4.2",
  "identifier": "com.samsung.buildhomebinary",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Build HomeBinary",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../engine/**/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3MjM5QTFGQjE2MTJDRkEKUldUNkxHR3hINW9qNStSdlYzWEZESEF4RGZHQjZwRzdJaUxRSk1sbExsbTdlZHl1eG84SHMxUVYK",
      "endpoints": [
        "https://github.com/endrisusanto/Home-Binary/releases/latest/download/latest.json"
      ]
    }
  }
}
